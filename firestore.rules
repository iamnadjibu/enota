rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated() && request.auth.token.email == "nadjibullahu@gmail.com";
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        isMaster() || (
          getUserData().role == "admin" &&
          getUserData().status == "active"
        )
      );
    }

    function userHasFaculty(facultyStr) {
      let userFac = getUserData().faculty;
      return (userFac is list && facultyStr in userFac) || (userFac == facultyStr);
    }

    function isFacultyAdmin(facultyStr) {
      return isMaster() || (
        isAdmin() && userHasFaculty(facultyStr)
      );
    }

    function userHasAnyFaculty(courseFacultiesList) {
      let userFac = getUserData().faculty;
      return (userFac is list && courseFacultiesList.hasAny(userFac)) ||
             (! (userFac is list) && courseFacultiesList.hasAny([userFac]));
    }

    // --- COLLECTIONS ---

    // Users Collection
    match /users/{userId} {
      // Admins can see all users, users can see themselves
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      // Anyone can register
      allow create: if true; 
      // Users can update their own profile (excluding sensitive fields), Master can update anyone
      allow update: if isMaster() || (
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'faculty', 'institution', 'regNumber'])
      );
      // Only Master can delete users
      allow delete: if isMaster();
    }

    // Marks Collection (Public Access for Searching)
    match /marks/{markId} {
      // Requirement: Users can search for marks without logging in
      allow read: if true; 
      
      // Admins can add marks for students in their faculty
      allow create: if isMaster() || isFacultyAdmin(request.resource.data.faculty);
      // But they cannot edit them, only Superadmin can
      allow update: if isMaster();
      allow delete: if isMaster();
    }

    // Courses/Materials Collection
    match /courses/{courseId} {
      // Requirement: Access materials in their faculty that they have signed up in (Filtered on UI)
      // Admins can see all courses
      // Students must be logged in
      allow read: if isAuthenticated();
      
      // Writes restricted to Master or Faculty Admins
      // We check if the admin has the legacy primary faculty or any of the faculties in the array
      allow create: if isMaster() || isFacultyAdmin(request.resource.data.faculty) || (isAdmin() && userHasAnyFaculty(request.resource.data.faculties));
      allow update: if isMaster() || isFacultyAdmin(resource.data.faculty) || (isAdmin() && userHasAnyFaculty(resource.data.faculties));
      allow delete: if isMaster() || isFacultyAdmin(resource.data.faculty) || (isAdmin() && userHasAnyFaculty(resource.data.faculties));
    }

    // Settings/Branding
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isMaster();
    }

    // Site Configurations
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isMaster();
    }
    
    // Metadata Collections
    match /faculties/{facultyId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /institutions/{instId} {
      allow read: if true;
      allow write: if isMaster();
    }
  }
}


